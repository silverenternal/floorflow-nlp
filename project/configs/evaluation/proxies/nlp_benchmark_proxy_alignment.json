      "no internal proxy uses final-test labels at inference"
    ],
    "fail_if": [
      "a benchmark metric has no proxy or governance explanation",
      "proxy loss is disconnected from the joint objective",
      "proxy rank correlation is below the frozen gate",
      "proxy quality is reported as external benchmark quality"
    ]
