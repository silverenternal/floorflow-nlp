{
  "version": "nlp-tree-action-corpus-v1",
  "status": "ready",
  "ast_corpus": ".data/nlp/ast_core_v1/corpus.jsonl",
  "grammar": "project/configs/structured_generation/transition_grammar_ast/ast_grammar_transition/nlp_ast_transition_grammar_base.json",
  "output": ".data/nlp/tree_action_v1/corpus.jsonl",
  "manifest": ".data/nlp/tree_action_v1/manifest.json",
  "prompt": {
    "max_prompt_chars": 512,
    "max_symbol_names": 8,
    "max_identifiers": 24,
    "max_operators": 12,
    "max_literals": 12,
    "max_constructs": 16,
    "max_comment_fragments": 4,
    "max_comment_chars": 240,
    "max_docstring_chars": 320,
    "minimum_source_line_chars_for_leak_check": 24
  },
  "fragments": {
    "enabled": true,
    "max_fragments_per_row": 4,
    "max_fragment_chars": 12000,
    "max_fragment_nodes": 256,
    "declaration_types": {
      "python": [
        "function_definition",
        "class_definition",
        "decorated_definition"
      ],
      "rust": [
        "function_item",
        "struct_item",
        "enum_item",
        "trait_item",
        "impl_item"
      ],
      "cpp": [
        "function_definition",
        "class_specifier",
        "struct_specifier",
        "namespace_definition",
        "template_declaration"
      ]
    }
  },
  "prompt_policy": {
    "target_ast_in_prompt": false,
    "target_source_in_prompt": false,
    "complete_source_lines_in_prompt": false,
    "allowed_prompt_fields": [
      "language",
      "symbol_names",
      "symbol_kinds",
      "semantic_tokens",
      "python_docstrings",
      "natural_language_comments",
      "construct_summary"
    ]
  },
  "evidence_boundary": "Teacher-action training corpus only; it does not establish target-free generation quality."
}
