{
  "version": "nlp-open-capability-conversation-sft-v3",
  "name": "nlp-p12m-open-conversation-sft-v3",
  "arm": "candidate",
  "tier": "OPEN",
  "seed": 101,
  "status": "row_aligned_conversation_sft",
  "track": "open_capability_exploratory",
  "claim_boundary": "Un-compressed exploratory conversation checkpoint; not eligible for smallest or SOTA claims before compression and matched retesting.",
  "data": {
    "dataset": "row_aligned_instruction",
    "train": [
      ".data/nlp/chat_conversation_v3/train.jsonl"
    ],
    "validation": [
      ".data/nlp/chat_conversation_v3/validation.jsonl"
    ],
    "test": [
      ".data/nlp/p12m_v2/delta_test.jsonl"
    ],
    "manifest": ".data/nlp/chat_conversation_v3/manifest.json",
    "target_used_at_inference": false,
    "text_mode": "chat"
  },
  "model": {
    "architecture": "compact_hierarchical_decoder_candidate",
    "target_parameters": 11500000,
    "planned_corpus_tokens": 230000000,
    "parameter_budget_mode": "open_capability_exploratory",
    "max_context_tokens": 512,
    "vocab_size": 8192,
    "hidden_size": 320,
    "num_layers": 6,
    "intermediate_size": 1152,
    "net_parameter_growth_allowed": "exploratory_only",
    "tokenizer": ".data/nlp/tokenizer_v1/tokenizer.json",
    "enable_dynamic_stack": false,
    "enable_gap_ensemble": false
  },
  "optimizer": {
    "name": "adamw",
    "learning_rate": 0.00005,
    "weight_decay": 0.01,
    "micro_batch_size": 8,
    "gradient_accumulation_steps": 1
  },
  "runtime": {
    "device": "cuda:1",
    "precision": "bf16",
    "compile_model": false,
    "deterministic": false,
    "gpu_authorized": true
  },
  "evaluation": {
    "primary_max_new_tokens": 256,
    "primary_samples_per_task": 1,
    "temperature": 0.0,
    "best_of_n_in_primary": false,
    "benchmark_manifest": null
  },
  "training": {
    "max_steps": 1200,
    "checkpoint_every": 100,
    "validation_batches": 2,
    "workers": 8,
    "train_sequences_per_worker": 100000,
    "validation_sequences_per_worker": 64
  }
}
