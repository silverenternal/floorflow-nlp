{
  "version": "nlp-canonical-ir-v11",
  "status": "implementation_contract",
  "serialization": "nlp-ast-graph-v1",
  "parser_schema": "project/configs/structured_generation/ast_corpus_diagnostic/ast_prompts_schema/nlp_ast_schema.json",
  "parser_native_hashes_are_verified_at_runtime": true,
  "parser_packages": {
    "python": {
      "package": "tree-sitter-python",
      "version": "0.25.0",
      "abi_version": 15,
      "semantic_version": [0, 25, 0],
      "root": "module",
      "grammar_sha256": "2880af292af6b7b25cc73fc860b72fe5e46b4bce286520d50dfec5791c55cc7a",
      "native_sha256": "edf0862b2fda605a9c439955b2f60b248941c9af709222e7b1566bc603a0aa04"
    },
    "rust": {
      "package": "tree-sitter-rust",
      "version": "0.24.2",
      "abi_version": 15,
      "semantic_version": [0, 24, 1],
      "root": "source_file",
      "grammar_sha256": "9e5292c882a1785401253035cb3ca95771c42cc86aa9ed318cef418793c8ed39",
      "native_sha256": "a965112037009c8264531395977cfa236f8e8486d3d0af841f0145d22b43affa"
    },
    "cpp": {
      "package": "tree-sitter-cpp",
      "version": "0.23.4",
      "abi_version": 14,
      "semantic_version": null,
      "root": "translation_unit",
      "grammar_sha256": "7394a3fe96453f3b6aa19da5446f3859e01546f696c0f6632b16c9a2eff1a7b1",
      "native_sha256": "99d80b33712cb43559cd5d35d59c57f0c323bae496c863e5e3a2a8746824fe5c"
    }
  },
  "graph_fields": [
    "ordered_node_type_and_named_flag",
    "tree_sitter_field_name_edges",
    "anonymous_tokens",
    "utf8_leaf_lexical_values",
    "gap_before_each_leaf",
    "byte_spans",
    "deterministic_scope_ids_and_parent_paths",
    "declaration_symbol_name_kind_and_scope",
    "root_language_and_exact_source_sha256"
  ],
  "exact_replay": {
    "rule": "Render lexical leaves and gaps in source order, require byte-for-byte source equality, then reparse and require graph equality.",
    "comments": "Preserve as grammar leaves where parsed; never infer or rewrite comment meaning.",
    "trivia": "Preserve whitespace and other source gaps in gap_before; trailing uncovered bytes are attached to the root trivia node.",
    "unicode": "UTF-8 byte spans and strict UTF-8 decoding; malformed byte sequences are rejected."
  },
  "language_boundaries": {
    "python": {
      "root": "module",
      "preserves": ["indentation", "comments", "string spelling", "anonymous punctuation", "line endings"],
      "does_not_claim": ["runtime name resolution", "type inference", "macro expansion"]
    },
    "rust": {
      "root": "source_file",
      "preserves": ["comments", "token spelling", "anonymous punctuation", "whitespace", "attributes"],
      "does_not_claim": ["borrow checking", "trait resolution", "macro expansion", "compiler semantics"]
    },
    "cpp": {
      "root": "translation_unit",
      "preserves": ["comments", "preprocessor token spelling", "anonymous punctuation", "whitespace", "raw strings"],
      "does_not_claim": ["macro expansion", "template instantiation", "name lookup", "compiler semantics"]
    }
  },
  "unsupported_policy": {
    "parse_error": "Reject the whole row; retain case ID and parser error in the audit.",
    "unknown_language_or_schema": "Reject; never silently drop or coerce fields.",
    "parser_version_or_hash_mismatch": "Reject replay and invalidate dependent manifests.",
    "semantic_equivalence": "Out of scope; canonical identity means exact supported-source replay only."
  },
  "evidence_boundary": "Pinned parser and reversible source representation; no compiler-semantic or generated-model quality claim."
}
