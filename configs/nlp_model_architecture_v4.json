{
  "version": "nlp-model-architecture-v4",
  "status": "verified_typed_output_and_macro_contracts",
  "track": "open_capability_exploratory",
  "supersedes": "configs/nlp_model_architecture_v3.json",
  "output_contract": "rust/nlp_flow_codegen:OUTPUT_CONTRACT_ROWS",
  "model": {
    "vocab_size": 8192,
    "hidden_size": 320,
    "num_layers": 6,
    "num_heads": 4,
    "num_kv_heads": 2,
    "intermediate_size": 1152,
    "max_seq_len": 512,
    "parameter_cap": 23000000,
    "tie_embeddings": true,
    "enable_typed_channels": true,
    "enable_typed_fusion": true,
    "enable_two_stage_cfm": true,
    "enable_json_action_head": true,
    "enable_json_schema_key_head": true,
    "enable_dynamic_stack": true,
    "dynamic_min_steps": 1,
    "dynamic_max_steps": 8,
    "dynamic_parallel_lanes": 4,
    "dynamic_parallel_top_k": 2,
    "dynamic_lane_rank": 16,
    "enable_gap_ensemble": false,
    "enable_benchmark_proxy": true,
    "proxy_test_output_classes": 128,
    "proxy_max_constraints": 16,
    "proxy_retrieval_dim": 64,
    "enable_turn_embeddings": true,
    "turn_type_count": 5,
    "enable_task_metadata": true,
    "task_family_count": 4,
    "task_language_count": 4,
    "enable_conversation_control": true,
    "use_learned_stop_at_inference": true,
    "enable_expert_bank": false,
    "enable_neuron_module": false,
    "enable_unified_competence": true,
    "unified_cell_rank": 16,
    "unified_top_k": 3,
    "unified_planner_dim": 128,
    "unified_generated_rank": 16,
    "unified_generated_basis_count": 4,
    "unified_generated_expert_mode": "online",
    "enable_runtime_competence": true,
    "runtime_competence_capacity": 16,
    "runtime_trigger_threshold": 0.5,
    "runtime_promotion_trials": 2,
    "runtime_promotion_success_rate": 0.75,
    "enable_emergence_objective": true,
    "emergence_basis_count": 64,
    "emergence_active_basis": 8
  },
  "inference_contract": {
    "stage_a": "generated token-endpoint AST",
    "stage_b_requires_verified_handoff": true,
    "json_requires_structural_and_schema": true,
    "patch_requires_application": true,
    "single_deterministic_sample": true,
    "parser_repair_allowed": false,
    "best_of_n_allowed": false,
    "schema_keys_only_from_allowed_keys": true
  },
  "runtime_autonomy": {
    "node_count": "learned",
    "source_token_length": "learned",
    "stage_a_nfe": "learned_uncertainty",
    "stage_b_nfe": "learned_uncertainty",
    "serial_depth": "learned_halting",
    "parallel_lanes": "learned_router_with_safety_cap",
    "generated_e_birth": "learned_birth_gate",
    "tuning_target": "zero_tuning_with_safety_caps"
  },
  "evidence_boundary": "Architecture and contract only; generated AST quality and capability remain to be measured."
}
