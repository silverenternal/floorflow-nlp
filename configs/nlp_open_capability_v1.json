{
  "version": "nlp-open-capability-v1",
  "name": "nlp-p12m-open-capability-pretrain-v1",
  "arm": "candidate",
  "tier": "OPEN",
  "seed": 83,
  "status": "capability_first_pretraining",
  "track": "open_capability_exploratory",
  "claim_boundary": "Un-compressed exploratory checkpoint; not eligible for smallest or SOTA claims before compression and matched retesting.",
  "data": {
    "train": [
      ".data/nlp/mixed_v1/corpus_v1/train.jsonl",
      ".data/nlp/p5m_v2/delta_train.jsonl",
      ".data/nlp/p12m_v2/delta_train.jsonl"
    ],
    "validation": [
      ".data/nlp/mixed_v1/corpus_v1/validation.jsonl",
      ".data/nlp/p5m_v2/delta_validation.jsonl",
      ".data/nlp/p12m_v2/delta_validation.jsonl"
    ],
    "test": [
      ".data/nlp/mixed_v1/corpus_v1/test.jsonl",
      ".data/nlp/p5m_v2/delta_test.jsonl",
      ".data/nlp/p12m_v2/delta_test.jsonl"
    ],
    "manifest": ".data/nlp/p12m_v2/manifest.json",
    "target_used_at_inference": false,
    "text_mode": "raw"
  },
  "model": {
    "architecture": "compact_hierarchical_decoder_candidate",
    "target_parameters": 11500000,
    "planned_corpus_tokens": 230000000,
    "parameter_budget_mode": "open_capability_exploratory",
