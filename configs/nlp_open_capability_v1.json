    "precision": "bf16",
    "compile_model": false,
    "deterministic": false,
    "gpu_authorized": true
  },
  "evaluation": {
    "primary_max_new_tokens": 256,
    "primary_samples_per_task": 1,
    "temperature": 0.0,
    "best_of_n_in_primary": false,
    "benchmark_manifest": null
  },
  "training": {
    "max_steps": 30000,
    "checkpoint_every": 500,
    "validation_batches": 2,
    "workers": 8,
    "train_sequences_per_worker": 500000,
    "validation_sequences_per_worker": 64
  }
