{
  "version": "nlp-open-emergence-joint-v1",
  "name": "nlp-p12m-open-emergence-joint-v1",
  "arm": "candidate",
  "tier": "OPEN",
  "seed": 431,
  "status": "unified_joint_emergence_training",
  "track": "open_capability_exploratory",
  "claim_boundary": "Un-compressed exploratory joint-training arm; emergence capability remains unproven until held-out executable composition passes.",
  "data": {
    "dataset": "row_aligned_instruction",
    "train": [
      ".data/nlp/chat_conversation_v3/train.jsonl"
    ],
    "validation": [
      ".data/nlp/chat_conversation_v3/validation.jsonl"
    ],
    "test": [
      ".data/nlp/p12m_v2/delta_test.jsonl"
    ],
    "manifest": ".data/nlp/chat_conversation_v3/manifest.json",
    "target_used_at_inference": false,
    "text_mode": "chat"
  },
  "model": {
    "architecture": "unified_competence_ast_first_v3",
    "target_parameters": 11500000,
    "planned_corpus_tokens": 230000000,
    "parameter_budget_mode": "open_capability_exploratory",
    "max_context_tokens": 512,
    "vocab_size": 8192,
    "hidden_size": 320,
    "num_layers": 6,
    "intermediate_size": 1152,
    "net_parameter_growth_allowed": "exploratory_only",
    "tokenizer": ".data/nlp/tokenizer_v1/tokenizer.json",
    "enable_typed_channels": true,
    "enable_typed_fusion": true,
    "enable_two_stage_cfm": true,
    "enable_json_action_head": true,
    "enable_dynamic_stack": true,
    "dynamic_min_steps": 1,
    "dynamic_max_steps": 8,
    "dynamic_parallel_lanes": 4,
    "dynamic_parallel_top_k": 2,
    "dynamic_lane_rank": 16,
    "dynamic_depth_weight": 0.02,
    "dynamic_target_depth": 3.0,
    "enable_unified_competence": true,
    "unified_cell_rank": 16,
    "unified_top_k": 3,
    "unified_planner_dim": 128,
    "unified_generated_rank": 16,
    "unified_generated_basis_count": 4,
    "unified_generated_expert_mode": "online",
    "enable_runtime_competence": true,
    "runtime_competence_capacity": 16,
    "runtime_trigger_threshold": 0.5,
    "runtime_promotion_trials": 2,
    "runtime_promotion_success_rate": 0.75,
    "enable_benchmark_proxy": true,
    "benchmark_proxy_loss_weight": 0.2,
    "proxy_test_output_classes": 128,
    "proxy_max_constraints": 16,
    "proxy_retrieval_dim": 64,
    "enable_turn_embeddings": true,
    "turn_type_count": 5,
    "enable_conversation_control": true,
    "conversation_control_loss_weight": 0.5,
    "use_learned_stop_at_inference": true,
    "enable_emergence_objective": true,
    "emergence_basis_count": 64,
    "emergence_active_basis": 8,
    "emergence_loss_weight": 0.05,
    "emergence_reward_weight": 0.1,
    "emergence_norm_envelope_ratio": 1.5
