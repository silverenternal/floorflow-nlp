  "optimizer": {
    "name": "adamw",
    "learning_rate": 0.00008,
    "weight_decay": 0.01,
    "micro_batch_size": 8,
    "gradient_accumulation_steps": 1
  },
  "runtime": {
    "device": "cuda:1",
    "precision": "bf16",
    "compile_model": false,
    "deterministic": false,
    "gpu_authorized": true
  },
  "evaluation": {
    "primary_max_new_tokens": 256,
